    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Círculo de fondo con degradado -->
    <path
        android:pathData="M 50,50 m -44,0 a 44,44 0 1,1 88,0 a 44,44 0 1,1 -88,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item
                    android:color="#FF6657D9"
                    android:offset="0.0" />
                <item
                    android:color="#FF9B8CFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Forma central blanca (Opacidad ~92% -> Alpha EB en HEX) -->
