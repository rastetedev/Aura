        android:fillColor="#EBFFFFFF"
        android:pathData="M30,50 C30,42 34,36 40,36 C46,36 48,46 52,46 C56,46 58,38 64,38 C68,38 70,43 70,50 C70,58 66,64 60,64 C54,64 52,54 48,54 C44,54 42,62 36,62 C32,62 30,57 30,50 Z" />

    <!-- Círculo interior morado (Opacidad 20% -> Alpha 33 en HEX) -->
